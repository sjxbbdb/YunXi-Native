[Unit]
Description=YunXi Native Linux Agent daemon
After=default.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/yunxi/environment
ExecStart=/usr/bin/yunxi-linux daemon
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=10s
SyslogIdentifier=yunxi-native
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
NoNewPrivileges=yes
# Fish may submit a workspace under /tmp; keep the host namespace visible.
PrivateTmp=no
OOMPolicy=stop
MemoryHigh=1536M
MemoryMax=2G
TasksMax=128
LimitNOFILE=4096
UMask=0077

[Install]
WantedBy=default.target
